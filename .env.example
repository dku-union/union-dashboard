# ── Database (Neon PostgreSQL · Dashboard + Spring 공유) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_API_KEY=

# ── Auth ──
# Dashboard 측 union-session JWT 서명 키 (httpOnly 쿠키, 7일)
JWT_SECRET=
# Dashboard ↔ Spring 사이 internal JWT 서명 키 (HS256, ROLE_PUBLISHER/ADMIN)
INTERNAL_JWT_SECRET=

# ── Spring Boot Backend ──
SPRING_API_URL=https://api.your-spring-backend.example

# ── SMTP (Gmail · 이메일 인증 코드 + 워크스페이스 초대 메일) ──
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
